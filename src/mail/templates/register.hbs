<html>

  <head>
    <title>MSP Task Manager - Activation Email</title>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
  </head>

  <body
    style='margin: 0; padding: 0; min-width: 100%; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; background-color: #FAFAFA; color: #222222;'
  >
    <div style='max-width: 600px; margin: 0 auto;'>
      <!-- Header -->
      <div style='background-color: #2E86C1; padding: 24px; color: #ffffff;'>
        <h1
          style='font-size: 24px; font-weight: 700; line-height: 1.25; margin-top: 0; margin-bottom: 15px; text-align: center;'
        >
          Welcome to MSP Task Manager
        </h1>
      </div>

      <!-- Body -->
      <div style='padding: 24px; background-color: #ffffff;'>
        <p style='margin-top: 0; margin-bottom: 24px;'>Hello {{name}},</p>
        <p style='margin-top: 0; margin-bottom: 24px;'>
          Thank you for signing up for
          <strong>MSP Task Manager</strong>. To activate your account and start
          managing your tasks efficiently, please use the following activation
          code:
        </p>

        <h2
          style='font-size: 20px; font-weight: 700; line-height: 1.25; margin-top: 0; margin-bottom: 15px; text-align: center; color: #2E86C1;'
        >
          {{activationCode}}
        </h2>

        <p style='margin-top: 0; margin-bottom: 24px;'>
          Please enter this code on the activation page within the next
          <strong>5 minutes</strong>.
        </p>

        <p style='margin-top: 0; margin-bottom: 24px;'>
          If you did not create an MSP Task Manager account, please ignore this
          email.
        </p>
      </div>

      <!-- Footer -->
      <div
        style='background-color: #f6f6f6; padding: 24px; text-align: center;'
      >
        <p style='margin-top: 0; margin-bottom: 12px;'>
          Need help? Contact us at
          <a
            href='https://msp-taskmanager.com/support'
            target='_blank'
            style='color: #2E86C1; text-decoration:none;'
          >MSP Support</a>
        </p>
        <p style='margin-top: 0; font-size: 14px; color: #777;'>
          &copy; MSP Task Manager. All rights reserved.
        </p>
      </div>
    </div>
  </body>

</html>